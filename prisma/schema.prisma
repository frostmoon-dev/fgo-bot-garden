generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

model Character {
  id                  String   @id @default(cuid())
  name                String
  aliases             String[]
  color               String   @default("#c9a86a")
  description         String   @default("")
  personality         String   @default("")
  speechStyle         String   @default("")
  lore                String   @default("")
  relationship        String   @default("")
  scenario            String   @default("")
  greeting            String   @default("")
  exampleDialogues    String   @default("")
  // Where and how a new story starts, shown in the scene box (Location: …, Time: …).
  openingScene        String   @default("")
  // FGO-style bond points with the user. Grows with every exchange.
  bond                Int      @default(0)
  // What this character remembers about the user from all their stories together. Written in the
  // background as stories go on (src/lib/memory), editable in the character editor.
  memories            String   @default("")
  // How the sprite moves as it talks: expressive, bouncy, calm or still (see src/lib/motion.ts).
  motion              String   @default("expressive")
  defaultSpriteSetId  String?
  defaultBackgroundId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  expressions  Expression[]
  spriteSets   SpriteSet[]
  casts        SessionCast[]
  mainSessions Session[]
}

model Expression {
  id          String @id @default(cuid())
  characterId String
  key         String
  label       String @default("")
  description String @default("")
  sortOrder   Int    @default(0)

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faces     SpriteFace[]

  @@unique([characterId, key])
}

// One ascension: an FGO-style sprite sheet (body on top, face cells below) and its own definition.
// Empty definition fields fall back to the character's profile.
model SpriteSet {
  id          String @id @default(cuid())
  characterId String
  name        String
  sheetUrl    String
  sheetWidth  Int    @default(1024)
  sheetHeight Int    @default(1792)
  bodyHeight  Int    @default(768)
  cellSize    Int    @default(256)
  columns     Int    @default(4)
  faceCount   Int    @default(0)
  faceX       Int    @default(384)
  faceY       Int    @default(160)
  sortOrder   Int    @default(0)

  description      String @default("")
  personality      String @default("")
  speechStyle      String @default("")
  lore             String @default("")
  relationship     String @default("")
  scenario         String @default("")
  greeting         String @default("")
  exampleDialogues String @default("")
  openingScene     String @default("")
  // Empty: moves like the character's profile says.
  motion           String @default("")

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faces     SpriteFace[]
}

// Which face cell a sprite set uses for an expression. cellIndex -1 = the face drawn on the body.
model SpriteFace {
  id           String @id @default(cuid())
  spriteSetId  String
  expressionId String
  cellIndex    Int

  spriteSet  SpriteSet  @relation(fields: [spriteSetId], references: [id], onDelete: Cascade)
  expression Expression @relation(fields: [expressionId], references: [id], onDelete: Cascade)

  @@unique([spriteSetId, expressionId])
}

model Background {
  id          String @id @default(cuid())
  key         String @unique
  label       String @default("")
  imageUrl    String
  description String @default("")
  // A looping track that plays while this background is on screen. Empty for silence.
  musicUrl    String @default("")
}

model Persona {
  id          Int    @id @default(1)
  name        String @default("Master")
  description String @default("")
  addressAs   String @default("Master")
  // Who the user is in the world (a Master, Chaldea staff, a visitor…). Overrides what characters assume from canon.
  role        String @default("")
}

model LorebookEntry {
  id        String   @id @default(cuid())
  title     String   @default("")
  keywords  String[]
  content   String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Session {
  id              String   @id @default(cuid())
  title           String
  mode            String   @default("narrative")
  mainCharacterId String
  backgroundId    String?
  summary         String   @default("")
  summarizedUntil Int      @default(-1)
  // Notes the user pins for this story (like Character.AI story memory). Always sent.
  memory          String   @default("")
  // The scene box: Location, Time, Weather, Present, Mood, Situation. Kept up to date after replies.
  scene           String   @default("")
  // The scene the user wrote for this story (Write a scene). It replaces the main character's scenario.
  premise         String   @default("")
  // Which interlude this story is (1 to 3, unlocked by bond level). Null for ordinary stories.
  interlude       Int?
  // The last message already folded into the characters' memories.
  rememberedUntil Int      @default(-1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  mainCharacter Character     @relation(fields: [mainCharacterId], references: [id], onDelete: Cascade)
  cast          SessionCast[]
  messages      Message[]
  saves         SaveSlot[]
}

model SessionCast {
  sessionId   String
  characterId String
  spriteSetId String?

  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@id([sessionId, characterId])
}

model Message {
  id            String   @id @default(cuid())
  sessionId     String
  order         Int
  role          String
  activeVariant Int      @default(0)
  // Pinned messages stay in the prompt after they are summarized away.
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())

  session  Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variants MessageVariant[]

  @@index([sessionId, order])
}

model MessageVariant {
  id        String   @id @default(cuid())
  messageId String
  position  Int
  content   String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
}

model SaveSlot {
  id        String   @id @default(cuid())
  sessionId String
  slot      Int
  label     String   @default("")
  snapshot  Json
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, slot])
}

model Settings {
  id            Int     @id @default(1)
  temperature   Float   @default(0.9)
  maxTokens     Int     @default(900)
  textSpeed     Int     @default(45)
  autoSpeed     Int     @default(1600)
  uiScale       Float   @default(1)
  // How opaque the story screen's message window is (FGO frames): 1 is solid.
  windowOpacity Float   @default(0.8)
  // How loud background music plays, 0 to 1. 0 turns it off.
  musicVolume   Float   @default(0.5)
  loreScanDepth Int     @default(4)
  contextBudget Int     @default(6000)
  keepRecent    Int     @default(12)
  devMode       Boolean @default(false)
  theme         String  @default("night")
  customBg      String  @default("")
  font          String  @default("fgo")
  // How narration and actions look: italic, or plain (as in FGO).
  narrationStyle String @default("italic")
  // Story screen frames: "fgo" (like the game's story screen) or "simple" (theme colors).
  frameStyle     String @default("fgo")
  // Prompt tuning for the model in use.
  promptProfile    String  @default("balanced")
  contextSize      Int     @default(16384)
  topP             Float   @default(1)
  frequencyPenalty Float   @default(0)
  presencePenalty  Float   @default(0)
  // 0 = not sent. Not every provider accepts top_k.
  topK             Int     @default(0)
  memoryPlacement  String  @default("end")
  exampleMode      String  @default("auto")
  formatReminder   Boolean @default(true)
  stopAtUser       Boolean @default(true)
  customPrompt     String  @default("")
  sceneTracker     Boolean @default(true)
  autoChoices      Boolean @default(false)
  // Characters remember the user across stories (Character.memories).
  characterMemory  Boolean @default(true)
  // Characters may write private thoughts, shown quietly on the story screen.
  innerThoughts    Boolean @default(false)
  // Which small background requests the backup model does: "main" (none), "light" or "all" (lib/llm/connection.ts).
  helperModel      String  @default("main")
  // How many lines a reply should have: short, scene (an FGO-style scene) or long.
  replyLength      String  @default("scene")
}

// The AI provider, set in Settings > Connection. While baseUrl is empty the LLM_* environment variables are used.
model Connection {
  id        Int      @id @default(1)
  // Preset id from src/lib/llm/providers.ts, or "custom".
  provider  String   @default("custom")
  baseUrl   String   @default("")
  model     String   @default("")
  // Encrypted with a key derived from AUTH_SECRET. Never sent to the browser.
  apiKey    String   @default("")
  updatedAt DateTime @updatedAt
}

// A moment kept from a story: a snapshot of the screen, so the card still shows after the story,
// character or background changes. sessionId only links back; the card stays when the story is deleted.
model Moment {
  id         String   @id @default(cuid())
  sessionId  String?
  storyTitle String   @default("")
  // The background picture.
  imageUrl   String   @default("")
  // The character on screen: { sheetUrl, grid, cell } (see lib/moment.ts). Null for none.
  sprite     Json?
  speaker    String   @default("")
  color      String   @default("")
  text       String
  narration  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Token counts of one AI request, for the Usage page. Null counts: the provider didn't report them.
model Usage {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  // What the request was for: reply, scene, choices, summary, memory, write, interlude, test.
  purpose          String
  model            String
  promptTokens     Int?
  cachedTokens     Int?
  completionTokens Int?

  @@index([createdAt])
}
