# ---- Database (Supabase Postgres) ----
# Runtime connection. On Vercel use Supabase's pooled connection string (transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct connection, used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- AI model (optional) ----
# Easiest: leave these empty and connect a model in the app (Connection page); that takes precedence.
# These are the fallback for any OpenAI-compatible chat completions API.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# Prompt style, context size and sampling are set per model in the app under Settings → AI model.

# ---- Login ----
APP_PASSWORD=""
# At least 32 random characters. Generate one with: openssl rand -hex 32
# Also encrypts the API key saved on the Connection page: changing it means entering the key again.
AUTH_SECRET=""

# ---- Uploads (Supabase Storage). Leave empty locally to save uploads in public/uploads. ----
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="assets"
# Optional: your database's CA certificate (Supabase: Project Settings > Database >
# SSL Configuration > Download certificate). A file path, or the PEM text itself (use that on Vercel).
# Defaults to certs/supabase-ca.crt.
# DATABASE_CA_CERT="certs/supabase-ca.crt"

# Lets other chat sites (JanitorAI and the like) use your main model through this site:
# URL https://<your-site>/api/v1/chat/completions, API key = this password. Leave empty to keep it off.
# Use a long random password; anyone who has it can use your model's quota.
PROXY_KEY=
