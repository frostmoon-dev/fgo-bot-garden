# ---- Database (Supabase Postgres) ----
# Runtime connection. On Vercel use Supabase's pooled connection string (transaction mode).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct connection, used only by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ---- LLM (any OpenAI-compatible chat completions API) ----
LLM_BASE_URL="https://your-provider.example/v1"
LLM_API_KEY=""
LLM_MODEL="DeepSeek-V4-Flash-0731"

# ---- Login ----
APP_PASSWORD=""
# At least 32 random characters. Generate one with: openssl rand -hex 32
AUTH_SECRET=""

# ---- Uploads (Supabase Storage). Leave empty locally to save uploads in public/uploads. ----
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="assets"
